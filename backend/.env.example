QISHI_DEMO_MODE=1
QISHI_COOKIE_SECURE=0
QISHI_OPEN_REGISTRATION=1
# Defaults with registration enabled are 20 calls per user and 200 per site. 0 means unlimited.
# QISHI_USER_DAILY_CLOUD_CALLS=20
# QISHI_SITE_DAILY_CLOUD_CALLS=200
# QISHI_REGISTRATION_PER_HOUR=5
QISHI_DATA_DIR=data
QISHI_MATCH_THRESHOLD=0.70
QISHI_EMBEDDING_MODEL=
QISHI_RERANKER_MODEL=
QISHI_PAUSE_THRESHOLD=3
QISHI_PAUSE_WINDOW_DAYS=7
QISHI_SOURCE_CATALOG=

# Use the Baidu Qianfan API Key for in-app search and citations.
QISHI_SEARCH_PROVIDER=baidu
BAIDU_API_KEY=

# OpenAI-compatible chat completion endpoint, for example https://api.deepseek.com
CLOUD_BASE_URL=
CLOUD_API_KEY=
CLOUD_MODEL=deepseek-chat
# Optional local Chat Completions server. The endpoint must use a loopback address.
# QISHI_LOCAL_MODEL=qwen2.5-0.5b
# QISHI_LOCAL_MODEL_URL=http://127.0.0.1:8080/v1/chat/completions
# Additional chat models available at CLOUD_BASE_URL, separated by commas.
# CLOUD_EXTRA_MODELS=qwen4-max
CLOUD_TIMEOUT_SECONDS=90
# Default with registration enabled is 4096. Set 0 to omit the provider max_tokens field.
# CLOUD_MAX_TOKENS=4096
